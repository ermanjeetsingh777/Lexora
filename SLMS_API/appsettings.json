{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SLMS_API;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "SLMS_API",
    "Audience": "SLMS_API_Client",
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_KEY_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 180,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Backup": {
    "FolderPath": "C:\\SLMS_Backups"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "DefaultMemberPassword": "Password@123"
  },
  "Demo": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
