{
  "name": "slms-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "start:dev": "ng serve --configuration dev",
    "start:qa": "ng serve --configuration qa",
    "start:uat": "ng serve --configuration uat",
    "start:prod": "ng serve --configuration production",
    "build": "ng build",
    "build:local": "ng build --configuration local",
    "build:dev": "ng build --configuration dev",
    "build:qa": "ng build --configuration qa",
    "build:uat": "ng build --configuration uat",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui --project=chromium --project=public",
    "e2e:ui:all": "playwright test --ui",
    "e2e:ui:details": "playwright test --ui e2e/modules/entity-details.spec.ts --project=chromium",
    "e2e:headed": "playwright test --headed --project=chromium --project=public",
    "e2e:public": "playwright test --project=public",
    "e2e:features": "playwright test --project=chromium",
    "e2e:details": "playwright test e2e/modules/entity-details.spec.ts --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:mcp": "npx @playwright/mcp@latest --browser chromium --caps vision,pdf,tracing"
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.21",
    "@lucide/angular": "^1.23.0",
    "@primeuix/themes": "^2.0.0",
    "angular-calendar": "^0.32.2",
    "angular-draggable-droppable": "^9.0.1",
    "angular-resizable-element": "^8.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide": "^1.23.0",
    "primeclt": "^0.1.5",
    "primeng": "^21.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
