# Local API load test
LOCUST_HOST=https://localhost:7050
LOCUST_ENV=local
# Demo org admin (seeded when Demo:Enabled)
LOCUST_EMAIL=institution@slms.com
LOCUST_PASSWORD=Demo@12345
# Local HTTPS often uses a self-signed cert
LOCUST_VERIFY_SSL=false
# Users / spawn rate defaults (override via CLI)
LOCUST_USERS=20
LOCUST_SPAWN_RATE=5
LOCUST_RUN_TIME=2m
