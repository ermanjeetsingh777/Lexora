# Production — 1000 concurrent users (use carefully)
LOCUST_HOST=https://apiuniappx.runasp.net
LOCUST_ENV=prod
LOCUST_EMAIL=
LOCUST_PASSWORD=
LOCUST_VERIFY_SSL=true
# Target: 1000 users
LOCUST_USERS=1000
# Slower ramp than local — 20/sec → ~50s to reach 1000
LOCUST_SPAWN_RATE=20
LOCUST_RUN_TIME=5m
LOCUST_SHAPE=thousand
