# Production API load test — set credentials via env, do not commit secrets
LOCUST_HOST=https://apiuniappx.runasp.net
LOCUST_ENV=prod
LOCUST_EMAIL=
LOCUST_PASSWORD=
LOCUST_VERIFY_SSL=true
# Keep prod load conservative unless you own the capacity plan
LOCUST_USERS=10
LOCUST_SPAWN_RATE=2
LOCUST_RUN_TIME=1m
